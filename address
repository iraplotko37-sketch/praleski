<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
  <title>Где мы находимся — Хор «Пралески» ДМШИ №2 Брест</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      background-color: #FFF8E1;
      font-family: 'Segoe UI', 'Roboto', system-ui, -apple-system, sans-serif;
      color: #4B2C66;
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    a {
      text-decoration: none;
      color: inherit;
    }
    ul {
      list-style: none;
    }

    .site-header {
      background-color: #4B2C66;
      padding: 1rem 1.5rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1.2rem;
      box-shadow: 0 4px 12px rgba(75, 44, 102, 0.3);
    }
    .logo-title-group {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      flex-shrink: 0;
    }
    .logo-icon {
      width: 52px;
      height: 52px;
      display: block;
    }
    .site-title {
      font-size: 1.7rem;
      font-weight: 600;
      color: #FFF8E1;
      letter-spacing: 0.02em;
      line-height: 1.2;
      white-space: nowrap;
    }
    .site-title small {
      display: block;
      font-size: 0.85rem;
      font-weight: 400;
      color: #E6D5B8;
      letter-spacing: 0.03em;
      margin-top: 2px;
    }

    .nav-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.6rem;
      font-weight: 500;
      color: #FFF8E1;
      background-color: rgba(255, 248, 225, 0.1);
      padding: 0.5rem 1rem;
      border-radius: 2.5rem;
    }
    .nav-list a {
      padding: 0.4rem 0.2rem;
      border-bottom: 2px solid transparent;
      transition: border-color 0.2s, color 0.2s;
      font-size: 1rem;
      white-space: nowrap;
    }
    .nav-list a:hover {
      border-bottom-color: #FFF8E1;
      color: #E6D5B8;
    }
    .nav-list a.active-page {
      border-bottom-color: #FFF8E1;
      font-weight: 600;
      color: #ffffff;
    }

    .main-content {
      flex: 1;
      padding: 2.5rem 2rem 3rem;
      max-width: 1000px;
      margin: 0 auto;
      width: 100%;
    }

    .page-title {
      font-size: 2.2rem;
      font-weight: 600;
      color: #4B2C66;
      margin-bottom: 2rem;
      padding-bottom: 0.4rem;
      border-bottom: 3px solid #4B2C66;
      display: inline-block;
    }

    .map-card {
      background-color: #ffffff;
      border-radius: 20px;
      padding: 1.5rem;
      box-shadow: 0 6px 14px rgba(75, 44, 102, 0.08);
      border-left: 8px solid #4B2C66;
      margin-bottom: 2rem;
    }

    .map-container {
      width: 100%;
      height: 400px;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid #E6D5B8;
    }
    .map-container iframe {
      width: 100%;
      height: 100%;
      border: none;
    }

    .address-box {
      background-color: #ffffff;
      border-radius: 20px;
      padding: 1.8rem 2rem;
      box-shadow: 0 6px 14px rgba(75, 44, 102, 0.08);
      border-left: 8px solid #4B2C66;
      display: flex;
      align-items: flex-start;
      gap: 1rem;
    }
    .address-icon {
      width: 24px;
      height: 24px;
      flex-shrink: 0;
      fill: #4B2C66;
      margin-top: 3px;
    }
    .address-text {
      font-size: 1.05rem;
      color: #2d1b3d;
      line-height: 1.6;
    }
    .address-text strong {
      color: #4B2C66;
      font-weight: 600;
      display: block;
      margin-bottom: 0.2rem;
    }

    .site-footer {
      background-color: #4B2C66;
      color: #FFF8E1;
      text-align: center;
      padding: 1.8rem 1.5rem;
      font-size: 0.95rem;
      letter-spacing: 0.02em;
      margin-top: auto;
    }
    .site-footer .footer-address {
      color: #E6D5B8;
      margin: 0.4rem 0 0.3rem;
    }

    @media (max-width: 650px) {
      .site-header {
        flex-direction: column;
        align-items: flex-start;
      }
      .nav-list {
        flex-wrap: wrap;
        gap: 0.4rem 1.2rem;
        background: none;
        padding: 0.2rem 0;
      }
      .map-container {
        height: 300px;
      }
    }
  </style>
</head>
